<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="healthcare_schedule_view_list" model="ir.ui.view">
        <field name="name">healthcare.schedule.list</field>
        <field name="model">healthcare.schedule</field>
        <field name="arch" type="xml">
            <list string="Availabilities" editable="bottom">
                <field name="doctor_id" widget="many2one_avatar" options="{'no_create': True}"/>
                <field name="dayofweek"/>
                <field name="hour_from" widget="float_time"/>
                <field name="hour_to" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="healthcare_schedule_view_search" model="ir.ui.view">
        <field name="name">healthcare.schedule.search</field>
        <field name="model">healthcare.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="doctor_id"/>
                <filter string="Mine" name="mine" domain="[('doctor_id', '=', uid)]"/>
                <group>
                    <filter string="Doctor" name="group_by_doctor" context="{'group_by': 'doctor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="healthcare_schedule_action" model="ir.actions.act_window">
        <field name="name">Availabilities</field>
        <field name="res_model">healthcare.schedule</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_doctor': 1}</field>
    </record>
</odoo>
