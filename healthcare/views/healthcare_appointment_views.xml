<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="healthcare_appointment_view_calendar" model="ir.ui.view">
        <field name="name">healthcare.appointment.calendar</field>
        <field name="model">healthcare.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="start" date_stop="stop" color="doctor_id"
                      mode="week" quick_create="0" event_open_popup="1">
                <field name="doctor_id" avatar_field="avatar_128" filters="1"/>
                <field name="patient_id" avatar_field="avatar_128"/>
                <field name="reason"/>
                <field name="state" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="healthcare_appointment_view_list" model="ir.ui.view">
        <field name="name">healthcare.appointment.list</field>
        <field name="model">healthcare.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="start"/>
                <field name="duration" widget="float_time" optional="hide"/>
                <field name="doctor_id" widget="many2one_avatar"/>
                <field name="specialty_id" optional="show"/>
                <field name="patient_id" widget="many2one_avatar"/>
                <field name="reason" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'booked'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="healthcare_appointment_view_form" model="ir.ui.view">
        <field name="name">healthcare.appointment.form</field>
        <field name="model">healthcare.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_done" type="object" string="Mark as Done" class="btn-primary"
                            invisible="state != 'booked'" groups="healthcare.group_healthcare_doctor"/>
                    <button name="action_cancel" type="object" string="Cancel Appointment"
                            invisible="state != 'booked'"
                            confirm="Are you sure you want to cancel this appointment?"/>
                    <button name="action_reset" type="object" string="Re-book"
                            invisible="state != 'cancelled'" groups="healthcare.group_healthcare_doctor"/>
                    <field name="state" widget="statusbar" statusbar_visible="booked,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="doctor_id" widget="many2one_avatar" readonly="state != 'booked'"
                                   options="{'no_create': True}"/>
                            <field name="specialty_id"/>
                            <field name="patient_id" widget="many2one_avatar" readonly="state != 'booked'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="start" readonly="state != 'booked'"/>
                            <field name="duration" widget="float_time" readonly="state != 'booked'"/>
                            <field name="stop"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                    <notebook groups="healthcare.group_healthcare_doctor">
                        <page string="Doctor's Notes" name="notes">
                            <field name="notes" placeholder="Diagnosis, prescriptions, follow-up..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="healthcare_appointment_view_search" model="ir.ui.view">
        <field name="name">healthcare.appointment.search</field>
        <field name="model">healthcare.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="name"/>
                <field name="doctor_id"/>
                <field name="patient_id"/>
                <field name="specialty_id"/>
                <filter string="My Appointments" name="mine"
                        domain="['|', ('doctor_id', '=', uid), ('patient_id', '=', uid)]"/>
                <separator/>
                <filter string="Upcoming" name="upcoming"
                        domain="[('state', '=', 'booked'), ('start', '>=', 'now')]"/>
                <filter string="Booked" name="booked" domain="[('state', '=', 'booked')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Date" name="filter_start" date="start"/>
                <group>
                    <filter string="Doctor" name="group_by_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Patient" name="group_by_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="healthcare_appointment_action" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">healthcare.appointment</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No appointment yet</p>
            <p>Use <b>Book an Appointment</b> to pick a free slot with a doctor.</p>
        </field>
    </record>
</odoo>
