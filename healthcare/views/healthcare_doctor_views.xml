<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="healthcare_doctor_view_kanban" model="ir.ui.view">
        <field name="name">res.users.healthcare.doctor.kanban</field>
        <field name="model">res.users</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="w-25 p-1">
                            <field name="avatar_128" widget="image" alt="Avatar"/>
                        </aside>
                        <main class="w-100 ps-2 pt-1">
                            <field class="fw-bold fs-5" name="name"/>
                            <field name="healthcare_specialty_id" class="text-muted"/>
                            <field name="email" widget="email"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="healthcare_doctor_view_list" model="ir.ui.view">
        <field name="name">res.users.healthcare.doctor.list</field>
        <field name="model">res.users</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="name" widget="many2one_avatar" string="Name"/>
                <field name="healthcare_specialty_id"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="healthcare_user_view_form" model="ir.ui.view">
        <field name="name">res.users.healthcare.form</field>
        <field name="model">res.users</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="healthcare_specialty_id" class="text-muted"/>
                    </div>
                    <group>
                        <field name="email" widget="email"/>
                        <field name="phone" widget="phone"/>
                    </group>
                    <notebook>
                        <page string="Availabilities" name="availabilities" invisible="not healthcare_schedule_ids">
                            <field name="healthcare_schedule_ids">
                                <list>
                                    <field name="dayofweek"/>
                                    <field name="hour_from" widget="float_time"/>
                                    <field name="hour_to" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="healthcare_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain" eval="[('all_group_ids', 'in', [ref('group_healthcare_doctor')]), ('healthcare_specialty_id', '!=', False)]"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('healthcare_doctor_view_kanban')}),
            Command.create({'view_mode': 'list', 'view_id': ref('healthcare_doctor_view_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('healthcare_user_view_form')})]"/>
    </record>

    <record id="healthcare_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain" eval="[('all_group_ids', 'in', [ref('group_healthcare_patient')]), ('all_group_ids', 'not in', [ref('group_healthcare_doctor')])]"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('healthcare_doctor_view_kanban')}),
            Command.create({'view_mode': 'list', 'view_id': ref('healthcare_doctor_view_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('healthcare_user_view_form')})]"/>
    </record>
</odoo>
