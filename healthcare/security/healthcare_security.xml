<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_healthcare" model="res.groups.privilege">
        <field name="name">Healthcare</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_healthcare_patient" model="res.groups">
        <field name="name">Patient</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can book, see and cancel their own appointments.</field>
    </record>

    <record id="group_healthcare_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_patient'))]"/>
        <field name="comment">Manages their own appointments and availabilities.</field>
    </record>

    <record id="group_healthcare_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_doctor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manages all appointments, availabilities and specialties.</field>
    </record>
</odoo>
