<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="healthcare_booking_wizard_view_form" model="ir.ui.view">
        <field name="name">healthcare.booking.wizard.form</field>
        <field name="model">healthcare.booking.wizard</field>
        <field name="arch" type="xml">
            <form string="Book an Appointment">
                <group>
                    <group>
                        <field name="specialty_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="allowed_doctor_ids" invisible="1"/>
                        <field name="doctor_id" widget="many2one_avatar" options="{'no_create': True, 'no_open': True}"/>
                        <field name="is_doctor" invisible="1"/>
                        <field name="patient_id" widget="many2one_avatar" readonly="not is_doctor"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <label for="date"/>
                        <div class="d-flex align-items-center gap-2">
                            <button name="action_previous_day" type="object" icon="chevron_backward"
                                    class="btn-link" title="Previous day"/>
                            <field name="date" class="w-auto"/>
                            <button name="action_next_day" type="object" icon="chevron_forward"
                                    class="btn-link" title="Next day"/>
                        </div>
                        <field name="duration" widget="float_time"/>
                        <field name="reason" placeholder="e.g. Annual check-up"/>
                    </group>
                </group>
                <separator string="Available Slots — pick one"/>
                <div invisible="not doctor_id or slot_ids" class="text-muted">
                    No free slot for this doctor on that day. Try another day.
                </div>
                <field name="slot_ids" invisible="not slot_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" widget="boolean_toggle" nolabel="1" width="60px"/>
                        <field name="start" string="From" readonly="1" force_save="1"/>
                        <field name="stop" string="To" readonly="1" force_save="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_book" type="object" string="Book" class="btn-primary"
                            invisible="not slot_ids"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="healthcare_booking_wizard_action" model="ir.actions.act_window">
        <field name="name">Book an Appointment</field>
        <field name="res_model">healthcare.booking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
